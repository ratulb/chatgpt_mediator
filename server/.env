# LLM provider: openai (default), mock, ollama, generic
#LLM_PROVIDER=openai

# Mock mode — no API key needed, returns canned replies
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=""
# LLM_MODEL=gpt-4o-mini

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Generic OpenAI-compatible (OpenRouter, Groq, Together, DeepSeek, etc.)
# LLM_PROVIDER=generic
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=""
