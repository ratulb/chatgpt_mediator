const ABORT_RESPONSE = "ABORT_RESPONSE";
const EMPTY_QUERY = "EMPTY_QUERY";
const AMBIGUOUS_RESPONSE = "AMBIGUOUS_RESPONSE";
const REQUEST_ABORT_MSG = "Request cancelled by user!";
const NORMAL = "NORMAL";
const COMM_FAILURE = "COMM_FAILURE";
const COMMUICATION_FAILURE_MSG = "Communication failure due to heavy traffic! Please try after a moment";
export const timeout = (delay) => {
  return new Promise((res) => setTimeout(res, delay));
};

var abortController;

export function abort() {
  if (abortController) {
    abortController.abort();
  }
}

async function fetchData(prompt, botMessageId) {
  const BACKEND_URL = "https://chatgptmediator.onrender.com";
  let data;
  try {
    abortController = new AbortController();
    const response = await fetch(BACKEND_URL, {
      method: "POST",
      signal: abortController.signal,
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        prompt: prompt,
      }),

    });

    if (response.ok) {
      const resp = await response.json();
      //Takes care of spurious "," at the beginning of res
      const dataTrimmed = resp.bot.trim().replace(/^,/, "").trim();
      data = dataTrimmed;
    } else {
      try {
        const err = await response.text();
        console.log({ err });
        data =
          "Communication failure due to heavy traffic! Please try after a moment!";
      } catch (error) {
        console.log({ error });
        data =
          "Communication failure due to heavy traffic! Please try after a moment!!";
      }
    }
  } catch (abortOrNetworkError) {
    console.error({ abortOrNetworkError });
    if (abortOrNetworkError.name == 'AbortError') { // handle abort()
      console.log("Request aborted!", abortOrNetworkError.message);
      data = REQUEST_ABORT_MSG;
    } else {
      data =
        "Communication failure due to heavy traffic! Please try after a moment!!!";
    }
  }

  const useLocalStore = localStorage.getItem("store_type") === "localStorage";
  const storage = useLocalStore ? localStorage : sessionStorage;
  var storedConversations = storage.getItem("conversations");
  storedConversations = storedConversations ? storedConversations : "[]";
  storedConversations = JSON.parse(storedConversations);

  var msgType = null;
    if (data === REQUEST_ABORT_MSG) {
    msgType = ABORT_RESPONSE;

  } else if (data.match(COMMUICATION_FAILURE_MSG)) {
    msgType = COMM_FAILURE;
  }

  else {

    if (storedConversations.length > 0) {
      var prevChat = storedConversations[storedConversations.length - 1];
      var prevChatId = prevChat.messageId + "_bot";
      var prevChatType = prevChat.type;
      if (botMessageId === prevChatId && prevChatType === EMPTY_QUERY) {
        msgType = AMBIGUOUS_RESPONSE;
      } else {
        msgType = NORMAL;
      }

    } else {
      msgType = NORMAL;
    }
  }
  const enrichedMsg = { messageId: botMessageId, prompt: data, type: msgType, time: new Date().getTime(), user: false };
  storedConversations.push(enrichedMsg);
  storage.setItem("conversations", JSON.stringify(storedConversations));
  return { content: data, type: msgType};
};


export default fetchData;

