import React, { useState, useEffect, useRef, useLayoutEffect } from 'react';
import recognitionOnIcon from "../../assets/VoiceOnIcon.png";
import recognitionOffIcon from "../../assets/VoiceOffIcon.png";
import { getUserLang, Tooltip } from '../common';
import "./recognition.css";


const VoiceRecognitionButton = ({ recognizer, setTextAreaContent, textAreaHandle }) => {

    const [recognitionOn, setRecognition] = useState(false);
    const [displayed, setDisplayed] = useState([]);
    const [finalRecognition, setFinalRecognition] = useState(false);
    const currSpeech = useRef("");
    var currentRecognition;

    const toggleSpeechRecognition = (e) => {
        setRecognition(!recognitionOn);
    };

    const comma = (transcripts) => {
        const first = transcripts[0];
        const transcript = first ? first.transcript : "";
        console.log("The trascript:", { transcripts });

        var match =
            transcript.match("comma please") ||
            transcript.match("put a comma") ||
            transcript.match("put comma") ||
            transcript.match("insert a comma") ||
            transcript.match("insert comma") ||
            transcript.match("place a comma") ||
            transcript.match("place comma") ||
            transcript.match("comma");

        if (match) {
            const matched = match[0];
            //const index = match.index;
            const input = match.input;
            return [input.replace(" " + matched, ",")];
        }
        return [transcript];
    };

    const dot = (transcripts) => {
        const transcript = transcripts[0];
        var match =
            transcript.match("full stop") ||
            transcript.match("put a dot") ||
            transcript.match("dot please") ||
            transcript.match("put dot") ||
            transcript.match("insert a dot") ||
            transcript.match("insert dot") ||
            transcript.match("place a dot") ||
            transcript.match("place dot") ||
            transcript.match("dot") ||
            transcript.match("place a period") ||
            transcript.match("place period") ||
            transcript.match("period");

        if (match) {
            const matched = match[0];
            const input = match.input;
            return [input.replace(" " + matched, ".")];
        }
        return [transcript];
    };


    const cleanUpAll = (transcripts) => {
        try {
            var transcript = transcripts[0];
            var match =
                transcript.match("clear all") ||
                transcript.match("clean up") ||
                transcript.match("delete all");
            if (match) {
                clean();
                return [];
            } else {
                return [transcript];
            }
        } catch (error) {
            console.error(error);
        } finally {

        }
    };

    const commands = useRef([(transcripts) => comma(transcripts)], (transcripts) => dot(transcripts));
    //(transcript) => dot(transcript), (transcript) => cleanUpAll(transcript)]);


    const stopSpeechRecognition = () => {
        console.log("Stopping recognition");
        if (currentRecognition) {
            currentRecognition.stop();
        }
    };


    /***useEffect(() => {
        const content = displayed.join(" ");
        setTextAreaContent(content);
    }, [finalRecognition, displayed]);
***/
    const startSpeechRecognition = () => {
        if (!currentRecognition) {
            currentRecognition = initRecoginizer(recognizer);
            currentRecognition.onend = (event) => {
                setRecognition(false);
                stopSpeechRecognition();
            }

            currentRecognition.addEventListener("result", (event) => {
                currSpeech.current = Array.from(event.results, (results) => {
                    var transcripts = results;
                    setFinalRecognition(results.isFinal);
                    console.log("Is this final trascript:", results.isFinal);
                    console.log("Is this final trascript:", results.isFinal);


                    /***commands.current.forEach(each => {
                        
                        transcripts = each(transcripts);
                        console.log("How many times? ", {transcripts}, {each});
                    });***/
                    transcripts = comma(transcripts);

                    transcripts = dot(transcripts);

                    transcripts = cleanUpAll(transcripts);

                    return transcripts;
                }).join('');
                //console.log("Speech content & isFinal : ", currSpeech.current, finalRecognition);
                if (finalRecognition) {
                    /***setDisplayed((prevSpeeches) => {
                        console.log("Previously the length was: ", prevSpeeches.length);

                        return [...prevSpeeches, currSpeech.current];

                    });***/
                    //setTextAreaContent(new Date().toISOString());
                    if (!currSpeech.current.match(' delete all')) {
                        console.log("I am adding: ", currSpeech.current);
                        setDisplayed(oldSpeeches => [...oldSpeeches, new Date().toISOString()]);
                    } else {
                        console.log("I am not adding *********: ", currSpeech.current);
                    }
                    // setFinalRecognition(prev => !prev);

                }
                //const content = displayed.join(" ");
                //setTextAreaContent(content);
            });
        }
        currentRecognition.start();
        console.log("Starting recognition");
    };


    function clean() {
        setDisplayed([]);
        setTextAreaContent("");
        //setFinalRecognition(curr => !curr);
    }



    const initRecoginizer = (recognizer) => {
        currentRecognition = new recognizer();
        currentRecognition.continuous = true;
        currentRecognition.lang = getUserLang();
        currentRecognition.interimResults = true;
        currentRecognition.maxAlternatives = 1;
        return currentRecognition;
    };


    useEffect(() => {

        if (recognitionOn) {
            startSpeechRecognition();
        }
        else {
            stopSpeechRecognition();
        }
        return () => stopSpeechRecognition();

    }, [recognitionOn]);

    return (
        <Tooltip content="Toggle speech recognition. Say coma, full stop etc to punctuate" direction="top">
            <button type="button" onClick={(e) => toggleSpeechRecognition(e)}>
                <img src={recognitionOn ? recognitionOnIcon : recognitionOffIcon} className={recognitionOn ? "recognition_on" : "recognition_off"} alt="Toggle voice recognition" />
            </button>
        </Tooltip>
    );
}

export default VoiceRecognitionButton;

